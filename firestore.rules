rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can create their own profile (signup) and read/update it
    // afterwards — but the `role` field is locked once set, so a signed-in
    // user can't grant themselves a different role later by editing their
    // own doc.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Placeholder deny-by-default for entities added in later modules
    // (vehicles, drivers, trips, maintenance, fuel logs, expenses).
    // Each module will replace this with rules scoped to that collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
